# Neon PostgreSQL connection used by the Hailing Log data APIs
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Simple login credentials. Authentication no longer requires user/user_sessions tables.
DEFAULT_ADMIN_USERNAME=kujang642
DEFAULT_ADMIN_PASSWORD=Kujang642Satkat1#

# Required/recommended: at least 32 random characters for token signing.
AUTH_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
